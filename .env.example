# Model name to pull and run via Ollama (e.g. gemma4:e2b, gemma2:2b, etc.)
OLLAMA_MODEL=gemma4:e2b

# Dual-Layer RAG Engine Path (relative or absolute)
MUTABLE_DATA_DIR=data/mutable
